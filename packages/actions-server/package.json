{
  "name": "@piddie/actions-server",
  "version": "0.0.0-development",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "find . -name '*.buildinfo' -o -name '*.tsbuildinfo' -delete  && rimraf ./dist",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "debug": "ts-node-dev --respawn --transpile-only --inspect src/server.ts",
    "mcp-server": "ts-node-dev --respawn --transpile-only src/WorkbenchToolsMcpServer.ts",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "dotenv": "^16.3.1",
    "express": "5.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "5.0.2",
    "@types/express-serve-static-core": "5.0.6",
    "@types/node": "^20.11.19",
    "@types/node-fetch": "2.6.12",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "node-fetch": "3.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
