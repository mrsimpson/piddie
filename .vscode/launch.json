{
  // Verwendet IntelliSense zum Ermitteln möglicher Attribute.
  // Zeigen Sie auf vorhandene Attribute, um die zugehörigen Beschreibungen anzuzeigen.
  // Weitere Informationen finden Sie unter https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach by Process ID",
      "processId": "${command:PickProcess}",
      "request": "attach",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "Debug Actions-Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/actions-server",
      "runtimeExecutable": "${workspaceFolder}/packages/actions-server/node_modules/.bin/ts-node-dev",
      "runtimeArgs": ["--respawn", "--transpile-only"],
      "args": ["src/server.ts"],
      "env": {
        "NODE_ENV": "development",
        "HTTP_PORT": "9100",
        "WS_PORT": "9101"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Workbench",
      "url": "http://localhost:9999",
      "webRoot": "${workspaceFolder}",
      "env": {
        "VITE_LITELLM_API_KEY": "sk-1234",
        "VITE_LITELLM_BASE_URL": "http://localhost:4000/v1",
        "VITE_LITELLM_MODEL": "llama3.1:latest"
      }
    }
  ]
}
